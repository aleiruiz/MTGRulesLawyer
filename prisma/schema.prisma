generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SnapshotStatus {
  CANDIDATE
  ACTIVE
  RETIRED
}

enum SourceRefreshStatus {
  RUNNING
  UNCHANGED
  IMPORTED
  FAILED
}

enum SourceKind {
  COMPREHENSIVE_RULES
  ORACLE_CARDS
  OFFICIAL_RULINGS
  LOCALIZED_CARD_NAMES
}

enum QuestionStatus {
  SUBMITTED
  INTERPRETED
  ANSWERED
  NEEDS_INFORMATION
}

enum CardFaceRole {
  FRONT
  BACK
  OTHER
}

enum RulingOutcome {
  RESOLVED
  CONDITIONAL
  NEEDS_INFORMATION
  UNCERTAIN
}

enum CitationKind {
  RULE
  CARD
  CARD_RULING
}

enum UserRole {
  USER
  ADMIN
}

enum ChallengeStatus {
  OPEN
  NEEDS_INFORMATION
  APPROVED
  REJECTED
}

enum ReviewDecision {
  REQUEST_INFORMATION
  APPROVE
  REJECT
}

enum ReviewErrorCategory {
  CARD_RESOLUTION
  MISSING_GAME_FACT
  RETRIEVAL
  REASONING
  OUTDATED_SOURCE
  PRESENTATION
}

enum UsageKind {
  INTERPRETATION
  RULING
  /// A second ruling attempt that may use web search, only after an uncertain answer.
  RULING_RESEARCH
  /// A second ruling attempt with the rules the first answer asked for.
  RULING_RETRY
}

enum AiReservationStatus {
  RESERVED
  IN_PROGRESS
  COMPLETED
  RELEASED
}

model DataSnapshot {
  id             String                @id @default(uuid()) @db.Uuid
  version        String                @unique
  status         SnapshotStatus        @default(CANDIDATE)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now()) @db.Timestamptz(6)
  activatedAt    DateTime?             @db.Timestamptz(6)
  sources        SourceSnapshot[]
  rules          Rule[]
  cards          Card[]
  rulingVersions RulingVersion[]
  rulingCache    VerifiedRulingCache[]
  judgeNotes     JudgeNote[]

  @@index([status, createdAt(sort: Desc)])
}

model SourceSnapshot {
  id                String           @id @default(uuid()) @db.Uuid
  snapshotId        String           @db.Uuid
  kind              SourceKind
  sourceUrl         String
  sourceVersion     String?
  sourcePublishedAt DateTime?        @db.Timestamptz(6)
  importedAt        DateTime         @default(now()) @db.Timestamptz(6)
  checksumSha256    String           @db.Char(64)
  snapshot          DataSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  rulingCitations   RulingCitation[]

  @@unique([snapshotId, kind])
  @@index([kind, importedAt(sort: Desc)])
}

model SourceRefreshLog {
  id              String              @id @default(uuid()) @db.Uuid
  runId           String              @db.Uuid
  kind            SourceKind
  status          SourceRefreshStatus @default(RUNNING)
  sourceUrl       String
  sourceVersion   String?
  checksumSha256  String?             @db.Char(64)
  snapshotVersion String?
  checkedAt       DateTime            @default(now()) @db.Timestamptz(6)
  completedAt     DateTime?           @db.Timestamptz(6)
  errorMessage    String?             @db.Text

  @@index([kind, checkedAt(sort: Desc)])
  @@index([runId])
}

model Rule {
  id            String               @id @default(uuid()) @db.Uuid
  snapshotId    String               @db.Uuid
  number        String
  text          String               @db.Text
  sortOrder     Int
  parentId      String?              @db.Uuid
  snapshot      DataSnapshot         @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  parent        Rule?                @relation("RuleTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Rule[]               @relation("RuleTree")
  referencesOut RuleCrossReference[] @relation("RuleReferenceSource")
  referencesIn  RuleCrossReference[] @relation("RuleReferenceTarget")
  citations     RulingCitation[]

  @@unique([snapshotId, number])
  @@index([snapshotId, sortOrder])
  @@index([parentId])
}

model RuleCrossReference {
  id         String @id @default(uuid()) @db.Uuid
  fromRuleId String @db.Uuid
  toRuleId   String @db.Uuid
  fromRule   Rule   @relation("RuleReferenceSource", fields: [fromRuleId], references: [id], onDelete: Cascade)
  toRule     Rule   @relation("RuleReferenceTarget", fields: [toRuleId], references: [id], onDelete: Cascade)

  @@unique([fromRuleId, toRuleId])
  @@index([toRuleId])
}

model Card {
  id            String         @id @default(uuid()) @db.Uuid
  snapshotId    String         @db.Uuid
  oracleId      String
  name          String
  layout        String
  typeLine      String         @default("")
  oracleText    String         @default("") @db.Text
  /// Mana value (converted mana cost) from the Oracle data.
  manaValue     Float?
  snapshot      DataSnapshot   @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  faces         CardFace[]
  rulings       CardRuling[]
  questionCards QuestionCard[]

  @@unique([snapshotId, oracleId])
  @@index([snapshotId, name])
  @@index([name])
}

/// A card face's printed name in another language (from Scryfall's printings), so players can
/// name cards the way their copies read. Keyed by Oracle ID, which is stable across snapshots;
/// one face can have several translations across printings.
model CardLocalizedName {
  id        String   @id @default(uuid()) @db.Uuid
  oracleId  String
  faceIndex Int
  /// ISO 639-1 code as Scryfall uses it, e.g. "es".
  language  String
  name      String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([language, oracleId, faceIndex, name])
  @@index([oracleId])
}

model CardFace {
  id            String           @id @default(uuid()) @db.Uuid
  cardId        String           @db.Uuid
  faceIndex     Int
  role          CardFaceRole     @default(OTHER)
  name          String
  manaCost      String           @default("")
  typeLine      String           @default("")
  oracleText    String           @default("") @db.Text
  power         String?
  toughness     String?
  loyalty       String?
  defense       String?
  imageUri      String?
  card          Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  questionCards QuestionCard[]
  citations     RulingCitation[]

  @@unique([cardId, faceIndex])
  @@unique([id, cardId])
  @@index([name])
}

/// An official ruling published by Wizards of the Coast for a card (from Scryfall's rulings data).
model CardRuling {
  id          String           @id @default(uuid()) @db.Uuid
  cardId      String           @db.Uuid
  position    Int
  publishedAt DateTime         @db.Date
  text        String           @db.Text
  card        Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  citations   RulingCitation[]

  @@unique([cardId, position])
}

model Question {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String?        @db.Uuid
  conversationId String?        @db.Uuid
  text           String         @db.Text
  gameState      Json?
  status         QuestionStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  user           AppUser?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  confirmedCards QuestionCard[]
  ruling         Ruling?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([conversationId, createdAt])
}

/// A signed-in user's chat with the judge: a first question and its follow-ups, in order.
/// Only each user's ten most recently active conversations are kept.
model Conversation {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  title     String     @db.VarChar(160)
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @db.Timestamptz(6)
  user      AppUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([userId, updatedAt(sort: Desc)])
}

model QuestionCard {
  id          String    @id @default(uuid()) @db.Uuid
  questionId  String    @db.Uuid
  cardId      String    @db.Uuid
  faceId      String?   @db.Uuid
  quantity    Int       @default(1)
  position    Int
  confirmedAt DateTime? @db.Timestamptz(6)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  card        Card      @relation(fields: [cardId], references: [id], onDelete: Restrict)
  face        CardFace? @relation(fields: [faceId, cardId], references: [id, cardId], onDelete: Restrict)

  @@unique([questionId, position])
  @@index([cardId])
  @@index([faceId])
}

model Ruling {
  id         String          @id @default(uuid()) @db.Uuid
  questionId String          @unique @db.Uuid
  createdAt  DateTime        @default(now()) @db.Timestamptz(6)
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  versions   RulingVersion[]
}

model RulingVersion {
  id                     String           @id @default(uuid()) @db.Uuid
  rulingId               String           @db.Uuid
  snapshotId             String           @db.Uuid
  version                Int
  outcome                RulingOutcome
  summary                String           @db.Text
  reasoningSteps         Json
  assumptions            String[]         @default([])
  summaryCitationIds     String[]         @default([])
  clarificationQuestions String[]         @default([])
  modelName              String?
  promptVersion          String?
  createdAt              DateTime         @default(now()) @db.Timestamptz(6)
  ruling                 Ruling           @relation(fields: [rulingId], references: [id], onDelete: Cascade)
  snapshot               DataSnapshot     @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  citations              RulingCitation[]
  challenges             Challenge[]
  correctedByEvent       ReviewEvent?     @relation("CorrectedVersion")

  @@unique([rulingId, version])
  @@index([snapshotId, createdAt(sort: Desc)])
}

model RulingCitation {
  id               String         @id @default(uuid()) @db.Uuid
  rulingVersionId  String         @db.Uuid
  // The initial SQL migration enforces that only the matching source FK is set for each kind.
  kind             CitationKind
  ruleId           String?        @db.Uuid
  cardFaceId       String?        @db.Uuid
  cardRulingId     String?        @db.Uuid
  label            String
  excerpt          String         @db.Text
  sourceUrl        String
  sourceSnapshotId String         @db.Uuid
  rulingVersion    RulingVersion  @relation(fields: [rulingVersionId], references: [id], onDelete: Cascade)
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict)
  rule             Rule?          @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  cardFace         CardFace?      @relation(fields: [cardFaceId], references: [id], onDelete: Restrict)
  cardRuling       CardRuling?    @relation(fields: [cardRulingId], references: [id], onDelete: Restrict)

  @@index([ruleId])
  @@index([cardFaceId])
  @@index([cardRulingId])
  @@index([rulingVersionId])
  @@index([sourceSnapshotId])
}

model AppUser {
  id             String         @id @default(uuid()) @db.Uuid
  supabaseUserId String         @unique
  role           UserRole       @default(USER)
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(6)
  questions      Question[]
  challenges     Challenge[]
  reviewEvents   ReviewEvent[]
  usageWindows   UsageWindow[]
  conversations  Conversation[]

  @@index([role, createdAt])
}

model Challenge {
  id                String          @id @default(uuid()) @db.Uuid
  rulingVersionId   String          @db.Uuid
  /// Null after the player deletes their account.
  userId            String?         @db.Uuid
  explanation       String          @db.Text
  proposedOutcome   RulingOutcome?
  evaluationConsent Boolean         @default(false)
  status            ChallengeStatus @default(OPEN)
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(6)
  rulingVersion     RulingVersion   @relation(fields: [rulingVersionId], references: [id], onDelete: Restrict)
  user              AppUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  reviewEvents      ReviewEvent[]

  @@unique([userId, rulingVersionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([rulingVersionId])
}

model ReviewEvent {
  id                  String               @id @default(uuid()) @db.Uuid
  challengeId         String               @db.Uuid
  /// Null after the reviewer deletes their account.
  reviewerId          String?              @db.Uuid
  decision            ReviewDecision
  errorCategory       ReviewErrorCategory?
  includeInEvaluation Boolean              @default(false)
  evaluationFixture   Json?
  fromStatus          ChallengeStatus?
  toStatus            ChallengeStatus
  reason              String               @db.Text
  correctedVersionId  String?              @unique @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  challenge           Challenge            @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  reviewer            AppUser?             @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  correctedVersion    RulingVersion?       @relation("CorrectedVersion", fields: [correctedVersionId], references: [id], onDelete: Restrict)

  @@index([challengeId, createdAt])
  @@index([reviewerId, createdAt])
}

model UsageWindow {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String?   @db.Uuid
  kind            UsageKind
  principalHash   String
  windowStartedAt DateTime  @db.Timestamptz(6)
  windowEndsAt    DateTime  @db.Timestamptz(6)
  unitsReserved   Int       @default(0)
  unitsConsumed   Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  user            AppUser?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([principalHash, kind, windowStartedAt])
  @@index([userId, kind, windowStartedAt])
  @@index([windowEndsAt])
}

model AiUsageReservation {
  id                 String              @id @default(uuid()) @db.Uuid
  accountHash        String?
  ipHash             String
  kind               UsageKind
  status             AiReservationStatus @default(RESERVED)
  reservedCostMicros BigInt
  actualCostMicros   BigInt?
  inputTokens        Int?
  outputTokens       Int?
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  expiresAt          DateTime            @db.Timestamptz(6)
  completedAt        DateTime?           @db.Timestamptz(6)

  @@index([accountHash, kind, createdAt])
  @@index([ipHash, kind, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model VerifiedRulingCache {
  key        String       @id @db.Char(64)
  snapshotId String       @db.Uuid
  answer     Json
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt  DateTime     @db.Timestamptz(6)
  snapshot   DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, expiresAt])
  @@index([expiresAt])
}

/// A verified conclusion the judge reached with web research, reused as guidance for later
/// questions about the same cards so they need no new search. Only model-written text that
/// passed citation verification and carries no links is stored; never the player's question.
model JudgeNote {
  id          String        @id @default(uuid()) @db.Uuid
  snapshotId  String        @db.Uuid
  /// Sorted Oracle IDs of the confirmed cards the conclusion is about.
  oracleIds   String[]
  outcome     RulingOutcome
  summary     String        @db.Text
  reasoning   String[]      @default([])
  ruleNumbers String[]      @default([])
  /// Pages the research read. Kept for maintainers; never shown to players or models.
  sourceUrls  String[]      @default([])
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  snapshot    DataSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, createdAt(sort: Desc)])
  @@index([oracleIds], type: Gin)
}
