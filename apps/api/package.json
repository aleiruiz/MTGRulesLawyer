{
  "name": "@mtg-rules/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/app.test.ts src/rules/import.test.ts src/cards/oracle-import.test.ts src/cards/source.test.ts",
    "import:rules": "tsx src/rules/import-cli.ts",
    "import:oracle": "tsx src/cards/import-cli.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@mtg-rules/contracts": "workspace:*",
    "@prisma/client": "6.19.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
