# API
HOST=0.0.0.0
PORT=3000
# Specific proxy IP addresses or CIDR ranges, comma-separated. Anything else stops the API at startup.
TRUSTED_PROXY_IPS=
# Exact browser origins (e.g. https://rules.example) allowed to call the API. When empty, development allows
# the local Expo web preview and production (NODE_ENV=production) allows no cross-origin browser access.
CORS_ALLOWED_ORIGINS=
DATABASE_URL=postgresql://mtg_rules:local-dev-only@localhost:5432/mtg_rules_lawyer
# Optional container image for PostgreSQL backup, restore, and rehearsal tools when they are not installed locally.
POSTGRES_CLIENT_IMAGE=
SOURCE_STALE_AFTER_HOURS=72
POSTGRES_DB=mtg_rules_lawyer
POSTGRES_USER=mtg_rules
POSTGRES_PASSWORD=local-dev-only
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=2500
OPENAI_REASONING_EFFORT=low
AI_RATE_LIMIT_HASH_KEY=replace-with-a-random-server-secret
AI_ANON_INTERPRETATIONS_PER_DAY=10
AI_ANON_RULINGS_PER_DAY=3
AI_ACCOUNT_INTERPRETATIONS_PER_DAY=30
AI_ACCOUNT_RULINGS_PER_DAY=10
AI_IP_BURST_PER_MINUTE=8
AI_GLOBAL_DAILY_COST_LIMIT_MICROS=5000000
# Daily monitoring workflow fails when actual plus reserved cost reaches this value.
# Defaults to 80% of AI_GLOBAL_DAILY_COST_LIMIT_MICROS when unset.
AI_DAILY_COST_ALERT_MICROS=
AI_RESERVED_COST_MICROS=30000
AI_MAX_CONCURRENT_CALLS=5
AI_RESERVATION_TTL_MS=180000
AI_EMERGENCY_STOP=false
# When a ruling comes back uncertain, try once more with one OpenAI web search (about US$0.01).
# Web pages only guide which supplied rules apply; answers must still cite rules and card text.
AI_WEB_RESEARCH=true
# Optional provider cost estimate rates, in micro-units per million input/output tokens.
AI_INPUT_COST_PER_MILLION_MICROS=
AI_OUTPUT_COST_PER_MILLION_MICROS=
# Verified rulings are cached for six hours; maximum is one day.
RULING_CACHE_TTL_MS=21600000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
# Server-only Supabase secret key, used only to delete a user's sign-in identity when they delete their
# account. Never put it in an EXPO_PUBLIC_ variable. Account deletion is unavailable while this is empty.
SUPABASE_SECRET_KEY=
# Admin requests need an authenticator-app check (Supabase aal2) no older than this. Defaults to one hour.
ADMIN_AUTH_MAX_AGE_SECONDS=3600
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional Expo API URL override. Use a public HTTPS origin for hosted web builds.
# Defaults to localhost for iOS/web development and 10.0.2.2 for Android emulator.
EXPO_PUBLIC_API_URL=
# Public origin hosting the Expo web app; used for share links from native builds.
EXPO_PUBLIC_WEB_URL=http://localhost:8081
