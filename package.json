{
  "name": "mtg-rules-lawyer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @mtg-rules/api dev",
    "dev:mobile": "pnpm --filter @mtg-rules/mobile start",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @mtg-rules/contracts build && eslint apps/mobile/app apps/api/src packages/contracts/src eslint.config.mjs",
    "lint:fix": "pnpm --filter @mtg-rules/contracts build && eslint apps/mobile/app apps/api/src packages/contracts/src eslint.config.mjs --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @mtg-rules/contracts build && pnpm -r --if-present typecheck",
    "test": "pnpm --filter @mtg-rules/contracts build && pnpm --filter @mtg-rules/api test",
    "audit:check": "node scripts/audit-dependencies.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.44.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.29"
    }
  }
}
